// Biome plugin: requests to the engine go through api() in js/api.js, which adds the X-Landscaper header the engine
// checks. A request made another way would be refused by the engine. So the page names fetch, XMLHttpRequest and sendBeacon
// nowhere else: not as a call, not on an object (`window.fetch`, `globalThis['fetch']`), not as a value (`const f = fetch`).
// tests/lint.test.js checks this against lint/fixtures/requests.js.
language js

or {
    `fetch`,
    `XMLHttpRequest`,
    `sendBeacon`,
    `$obj[$key]` where { $key <: r"^['\"`](?:fetch|XMLHttpRequest|sendBeacon)['\"`]$" }
} as $use where {
    register_diagnostic(span = $use, message = "Use api() from js/api.js: it sends the X-Landscaper header the engine requires")
}
